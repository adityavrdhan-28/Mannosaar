# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key

# NEXTAUTH
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=your_nextauth_secret

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_APP_URL=https://your-domain.com

# GOOGLE CALENDAR API
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=your-email@your-project.iam.gserviceaccount.com
GOOGLE_CALENDAR_PRIVATE_KEY=your_private_key

# EMAIL CONFIGURATION
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your_app_password

# RAZORPAY (Optional)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# PAYU (Required for hosted checkout)
PAYU_KEY=your_payu_merchant_key
PAYU_SALT=your_payu_merchant_salt
PAYU_PAYMENT_URL=https://secure.payu.in/_payment

# Optional: set to true for sandbox flows if you use the test endpoint in your setup
PAYU_IS_TEST=false

# Direct Meta Cloud API booking channel (enable after migration and sandbox checks)
WHATSAPP_BOOKING_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
# Set a supported version from your Meta app dashboard, e.g. v25.0
WHATSAPP_GRAPH_VERSION=
# Digits only, country code included. Leave empty to hide website CTA.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Independent random secret, >=32 characters; keep stable for active checkout links.
WHATSAPP_CHECKOUT_SECRET=
CRON_SECRET=
WHATSAPP_SESSION_TTL_MINUTES=120
WHATSAPP_REMINDER_MINUTES=1440,60
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_BOOKING_CONFIRMATION=booking_confirmation
WHATSAPP_TEMPLATE_BOOKING_REMINDER_24H=booking_reminder_24h
WHATSAPP_TEMPLATE_BOOKING_REMINDER_1H=booking_reminder_1h
WHATSAPP_TEMPLATE_BOOKING_RESCHEDULED=booking_rescheduled
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=booking_cancelled
WHATSAPP_TEMPLATE_PAYMENT_REMINDER=payment_reminder
# Optional AES-256-GCM application encryption for Google OAuth tokens.
# Generate with: openssl rand -base64 32. Keep stable; reconnect accounts to encrypt old credentials.
GOOGLE_TOKEN_ENCRYPTION_KEY=
